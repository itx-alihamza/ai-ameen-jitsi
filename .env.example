# ==============================================================================
# Ameen self-hosted Jitsi Meet — example configuration
#
# Copy to `.env` and fill in. NEVER commit the filled-in file: `.env` is
# gitignored here for that reason. Every password below is a real credential.
#
#   cp .env.example .env
#   ./generate-secrets.sh          # fills the four password fields
#
# Define each key exactly once. Docker Compose, like dotenv, silently keeps the
# LAST assignment of a duplicated key, so a stray second line wins quietly.
# ==============================================================================

# ── Image version ─────────────────────────────────────────────────────────────
# Pin a stable tag and move it deliberately. `latest` would mean an unannounced
# major upgrade on the next `docker compose pull`, and the Jitsi web image serves
# `external_api.js` to the Ameen frontend — a version skew there breaks the
# embedded conference.
JITSI_IMAGE_TAG=stable-9955

# ── Public identity ───────────────────────────────────────────────────────────
# The hostname browsers use. Must resolve publicly (or via /etc/hosts locally)
# and must match the certificate.
JITSI_DOMAIN=meet.example.sa

# Full public base URL, including the scheme. HTTPS in every environment that a
# real browser will use: microphone, camera, and screen sharing all require a
# secure context, and a plain-HTTP origin fails them with no useful error.
PUBLIC_URL=https://meet.example.sa

TZ=Asia/Riyadh

# ── Ports ─────────────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# The single UDP media port. Every participant's network must be able to reach it,
# which is the requirement that rules out most PaaS hosts (see README).
JVB_PORT=10000

# ── TLS ───────────────────────────────────────────────────────────────────────
# Let's Encrypt inside the container. Requires port 80 reachable from the
# internet for the HTTP-01 challenge, and a publicly resolvable JITSI_DOMAIN.
# Set to 0 when a reverse proxy in front terminates TLS instead.
ENABLE_LETSENCRYPT=1
LETSENCRYPT_EMAIL=ops@example.sa
# 1 while testing: the production ACME endpoint rate-limits failed attempts per
# domain per week, and a misconfigured DNS record burns through that quickly.
LETSENCRYPT_USE_STAGING=0

# Only for local development on http://localhost. Setting DISABLE_HTTPS=1 on any
# host a real user reaches will break microphone and camera access.
DISABLE_HTTPS=0
ENABLE_HTTP_REDIRECT=1

# ── Media routing (the setting most often wrong) ───────────────────────────────
# The IP address participants use to reach the videobridge.
#
# - Local development: your machine's LAN address (e.g. 192.168.1.20). NOT
#   127.0.0.1 — that is the address the *container* would advertise, so a second
#   participant on another device gets no media and the call connects with silence
#   and a frozen video tile.
# - VPS: the server's public IPv4 address.
DOCKER_HOST_ADDRESS=192.168.1.20

# Behind NAT (a cloud VM with a separate private address), advertise both so ICE
# can pick whichever works: JVB_ADVERTISE_IPS=<public-ip>,<private-ip>
JVB_ADVERTISE_IPS=

# ── Authentication (Ameen ↔ Jitsi) ────────────────────────────────────────────
# With these set, Prosody rejects any join that does not present a valid JWT.
# Ameen mints those tokens per user, per room, after running its own authorization
# checks — so a leaked room URL alone is not enough to enter a board meeting.
ENABLE_AUTH=1
# 0 is load-bearing. With guests enabled, an unauthenticated browser can join a
# room whose name it knows, and the token check becomes advisory.
ENABLE_GUESTS=0
AUTH_TYPE=jwt

# MUST match JITSI_JWT_APP_ID in the Ameen backend's .env.
JWT_APP_ID=ameen

# MUST match JITSI_JWT_APP_SECRET in the Ameen backend's .env.
# Generate with: openssl rand -hex 32
# This is the key that lets anything mint a valid join token. It belongs on the
# Jitsi host and the Ameen server, and nowhere else — never in a browser, a
# frontend build, a log line, or a commit.
JWT_APP_SECRET=

# ── Internal service credentials ──────────────────────────────────────────────
# Not user-facing, but a weak or shared value lets anything that reaches the
# internal network register as a Jitsi component and observe or disrupt every
# conference. Generate each independently:
#   openssl rand -hex 24
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=

JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=

# ── Live transcription (Jigasi) — optional ────────────────────────────────────
# Two things to turn on, both off by default:
#     ENABLE_TRANSCRIPTIONS=1   (below)
#     docker compose --profile transcription up -d
#
# Jigasi joins conferences as a hidden participant and streams audio to Ameen,
# which forwards it to Speechmatics and stores the resulting TEXT. It records
# nothing: RECORD_AUDIO and on-disk saving are pinned off in docker-compose.yml.
#
# A transcriber participant has room audio access — this narrows the "no
# server-side listener" guarantee the rest of this stack otherwise makes. See
# README §"Live transcription" before turning this on in production.
ENABLE_TRANSCRIPTIONS=0

JIGASI_XMPP_USER=jigasi
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_USER=transcriber
JIGASI_TRANSCRIBER_PASSWORD=
XMPP_HIDDEN_DOMAIN=hidden.meet.jitsi
JIGASI_BREWERY_MUC=jigasibrewery

# Where Jigasi sends audio. STATIC — Jigasi has no per-room way to parameterize
# this (see docker-compose.yml's comment on this exact var for why), so it never
# contains a meeting id. `token` is a FIXED value derived from
# TRANSCRIPTION_INGEST_SECRET below — mint it once with:
#     node -e "console.log(require('crypto').createHmac('sha256','<secret>').update('live-transcription-ingest').digest('hex'))"
# Which meeting is actually being transcribed is decided by Ameen's
# single-active transcription lease, not this URL. See
# ../deployment/README.md §"Live transcription".
TRANSCRIPTION_WEBSOCKET_URL=ws://backend:3001/internal/transcription/stream?token=<static-token>

# MUST equal TRANSCRIPTION_INGEST_SECRET in the Ameen backend's .env.
# Generate with: openssl rand -hex 32
TRANSCRIPTION_INGEST_SECRET=

# ── XMPP domains (internal only; defaults are fine) ───────────────────────────
# These are not public hostnames — they are internal XMPP identities resolved on
# the compose network. Change them only if you know why.
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
XMPP_BOSH_URL_BASE=http://prosody:5280
JVB_BREWERY_MUC=jvbbrewery

# ── Optional TURN ─────────────────────────────────────────────────────────────
# Not configured by default, and not required for most deployments: the Jitsi web
# image ships a coturn that covers TCP/443 fallback for participants whose network
# blocks UDP.
#
# Add an external TURN server when participants sit behind restrictive corporate
# firewalls that block outbound UDP entirely AND cannot reach TCP/443 on this
# host. See README §TURN for the trade-offs — a TURN relay carries media, so it is
# a second host that must be trusted with the meeting's audio and video.
# TURN_HOST=
# TURN_PORT=443
# TURN_CREDENTIALS=

# ── Explicitly disabled capabilities ──────────────────────────────────────────
# Listed here as documentation, not as knobs to turn on.
#
# `DISABLE_LOCAL_RECORDING=true` is set in docker-compose.yml, not here, because it
# must not be overridable per environment: the image defaults browser-side local
# recording to ENABLED, and Ameen stores no audio or video in any environment.
#
# Recording (jibri), live streaming, and transcription (jigasi) are OUT OF SCOPE.
# Ameen stores no audio or video: no recording service is deployed, no media
# volume exists, and the join token Ameen issues denies all three features per
# user. Enabling any of them requires adding a service to docker-compose.yml and
# changing the Ameen backend's token claims — it cannot happen by flipping a
# variable here, which is the point.
